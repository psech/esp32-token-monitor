#pragma once

// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored.

#define WIFI_SSID         "your-ssid"
#define WIFI_PASSWORD     "your-password"

// IP or hostname of the laptop running the Docker service.
#define SERVICE_HOST      "192.168.1.100"
#define SERVICE_PORT      8787

// How often the ESP32 polls the service. The 1px countdown bar at the
// bottom of the screen fills over this interval, regardless of the value.
// 60 s matches the service cache TTL; shorter polls mostly re-read the cache
// but each one powers up Wi-Fi, which dominates battery drain.
#define POLL_INTERVAL_MS  60000

// LCD backlight brightness, 0..100. The biggest constant load on battery.
#define BACKLIGHT_PERCENT 30

// Home Assistant over MQTT (optional). Leave MQTT_HOST undefined to skip it.
// The device publishes to the Mosquitto broker that HA's MQTT integration
// uses, and announces itself via MQTT discovery, so no HA config is needed.
#define MQTT_HOST         "192.168.1.100"
#define MQTT_PORT         1883
#define MQTT_USER         "your-mqtt-user"
#define MQTT_PASSWORD     "your-mqtt-password"
// #define HA_DEVICE_NAME      "Token Monitor"
// #define HA_DISCOVERY_PREFIX "homeassistant"
